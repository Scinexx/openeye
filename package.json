{
  "name": "openeye",
  "version": "2.0.0",
  "description": "Player stats, rankings, graveyard and item tracker for Open RotMG. Runs on Cloudflare Workers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled",
    "local": "node --no-warnings=ExperimentalWarning src/node/main.js",
    "collect": "node --no-warnings=ExperimentalWarning src/node/main.js --collect",
    "update-catalog": "node tools/update-catalog.mjs",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "license": "MIT"
}
